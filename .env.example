NEXT_PUBLIC_SITE_URL=https://vzonecoherence.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal (use sandbox credentials while testing; set PAYPAL_ENV=live in production)
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Brevo (newsletter + transactional email)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=vzoneco@gmail.com
BREVO_SENDER_NAME=V-Zone Coherence

# Contact form recipient
CONTACT_TO_EMAIL=vzoneco@gmail.com

# Vimeo (optional: only needed if you want to pull duration/thumbnail automatically)
VIMEO_ACCESS_TOKEN=

# Protects /api/cron/* (Vercel Cron sends this automatically as a Bearer token)
CRON_SECRET=
